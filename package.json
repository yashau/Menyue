{
	"name": "menyue",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "node scripts/dev.mjs",
		"dev:build": "node scripts/build-dev.mjs",
		"dev:runtime": "wrangler dev .svelte-kit/cloudflare-dev/_worker.js --config wrangler.dev.jsonc --ip 0.0.0.0 --port 5173 --local --persist-to .wrangler/state",
		"dev:setup": "node scripts/setup-local.mjs",
		"dev:reset": "node scripts/setup-local.mjs --reset",
		"test:local-admin-auth": "node scripts/verify-local-admin-session.mjs",
		"test:local-fixture": "node scripts/verify-local-fixture.mjs",
		"test:local-r2-fixture": "node scripts/verify-local-r2-fixture.mjs",
		"build": "wrangler types --check && vite build",
		"preview": "wrangler dev --config wrangler.jsonc --config realtime/wrangler.jsonc --ip 0.0.0.0 --port 4173 --local --persist-to .wrangler/state",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "oxlint .",
		"format": "oxfmt --write .",
		"format:check": "oxfmt --check .",
		"test:unit": "vitest tests/unit src/lib",
		"test": "vitest --run tests/unit src/lib",
		"test:e2e": "playwright test",
		"test:dev-lifecycle": "node scripts/test-dev-lifecycle.mjs",
		"test:local-runtime": "node scripts/verify-local-runtime.mjs",
		"test:e2e:baseline": "node scripts/run-e2e-evidence.mjs",
		"test:visuals": "node scripts/capture-visuals.mjs",
		"gen": "wrangler types",
		"migrate:local": "wrangler d1 migrations apply menyue --local --persist-to .wrangler/state",
		"bootstrap:local": "node scripts/bootstrap-local.mjs"
	},
	"dependencies": {
		"lucide-svelte": "^1.0.1",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@fontsource-variable/inter": "^5.2.8",
		"@internationalized/date": "^3.12.2",
		"@lucide/svelte": "^1.24.0",
		"@playwright/test": "^1.61.1",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^24",
		"bits-ui": "^2.18.1",
		"clsx": "^2.1.1",
		"miniflare": "4.20260708.0",
		"mode-watcher": "^1.1.0",
		"oxfmt": "^0.58.0",
		"oxlint": "^1.73.0",
		"oxlint-tailwindcss": "^1.3.4",
		"shadcn-svelte": "^1.4.1",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"svelte-sonner": "^1.1.1",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^4.1.8",
		"wrangler": "^4.97.0"
	},
	"packageManager": "pnpm@11.11.0"
}
