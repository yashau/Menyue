{
  "name": "menyue",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --host 0.0.0.0 --port 5290",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 5291",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "format": "prettier --write .",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "gates": "pnpm lint && pnpm test:unit && pnpm build",
    "db:migrate": "wrangler d1 migrations apply menyue --local",
    "db:migrate:remote": "wrangler d1 migrations apply menyue --remote",
    "db:seed": "node scripts/seed.mjs",
    "db:reset": "node scripts/reset.mjs",
    "setup": "pnpm db:migrate && pnpm db:seed"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "@internationalized/date": "^3.12.2",
    "@lucide/svelte": "^1.24.0",
    "@playwright/test": "^1.49.1",
    "@sveltejs/adapter-cloudflare": "^7.0.0",
    "@sveltejs/kit": "^2.15.1",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.10.5",
    "mode-watcher": "^1.1.0",
    "prettier": "^3.4.2",
    "prettier-plugin-svelte": "^3.3.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "svelte": "^5.16.0",
    "svelte-check": "^4.1.1",
    "tailwindcss": "^4.0.0",
    "tslib": "^2.8.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8",
    "wrangler": "^4.0.0"
  },
  "packageManager": "pnpm@11.11.0",
  "dependencies": {
    "bits-ui": "^2.18.1",
    "clsx": "^2.1.1",
    "svelte-dnd-action": "^0.9.70",
    "svelte-sonner": "^1.1.1",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.2.2",
    "tw-animate-css": "^1.4.0"
  }
}
